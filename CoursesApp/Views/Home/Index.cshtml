@using CourseManagement.Models.ViewModels
<h4>Ласкаво просимо до системи керування курсами</h4>
@model CourseListViewModel
<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var p in Model.Courses ?? Enumerable.Empty<Course>())
    {
        <partial name="_CourseSummary" model="p" />
    }
</div>
<nav aria-label="Course pagination" class="mt-4">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PagingInfo.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>