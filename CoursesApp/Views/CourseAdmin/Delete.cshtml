@model Course
@{
    ViewBag.Title = "Підтвердження видалення";
}
<h2>Ви впевнені, що хочете видалити курс?</h2>
<p>@Model.Title</p>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CourseID" />
    <button type="submit">Так, видалити</button>
    <a asp-action="Index">Скасувати</a>
</form>
