@using Microsoft.AspNetCore.Identity
@using CourseManagement.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html>
<head>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width" />
    <title>CoursesApp</title>
</head>
<body>
    <header class="bg-primary text-white p-3 mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <h1 class="h3">Система керування курсами</h1>

            <div>
                <a class="btn btn-light btn-sm"
                   asp-controller="Chosen"
                   asp-action="ViewChosen">
                    Вибране
                </a>
                
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-light btn-sm me-2">Кабінет</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Вийти</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-sm me-2">Увійти</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-sm">Реєстрація</a>
                }
            </div>
        </div>
    </header>


    <div class="container">
        <div class="row">
            <div class="col-md-3">
                @await Component.InvokeAsync("NavigationMenu")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>


    <footer class="bg-light text-center py-3 mt-4">
        <div class="container">
            <span>&copy; 2025 Система керування курсами</span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
