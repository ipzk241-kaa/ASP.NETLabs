        @RenderBody()
    </div>
    <footer class="bg-light text-center py-3 mt-4">
        <div class="container">
            <span>&copy; 2025 Система керування курсами</span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
