@model CoursesApp.Models.Course
<div class="col">
    <div class="card h-100 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <em>Викладач: @Model.Tea?.FullName</em><br />
            <p class="card-text">@Model.Description</p>
            <!--<p class="text-muted">Ціна: <strong>Model.Price</strong> грн</p>-->

            <a class="btn btn-outline-primary btn-sm mt-2"
               asp-controller="Chosen"
               asp-action="AddToChosen"
               asp-route-courseId="@Model.CourseID">
                Додати до вибраного
            </a>
        </div>
    </div>
</div>